# Copy to .env.production.local on the server and fill in. Next.js loads that
# file automatically. Never commit the filled-in version — it holds secrets.
#
# NOTE: NEXT_PUBLIC_* values are baked in at BUILD time, so they must be set
# before `npm run build`, not just before `npm start`.

# Canonical origin. Drives sitemap.xml, robots.txt and Open Graph URLs.
# Falls back to https://verantintel.com when unset.
NEXT_PUBLIC_SITE_URL=https://verantintel.com

# --- pilot signup notifications -------------------------------------------
# Without RESEND_API_KEY, form submissions are validated and logged but never
# delivered anywhere. Set it or signups are lost.
RESEND_API_KEY=

# Inbox that receives signups. Defaults to brief@verantintel.com.
LEAD_TO_EMAIL=brief@verantintel.com

# Sender. The domain must be verified in Resend or sending is rejected.
# Quoted: the angle brackets are shell redirection if this file is ever
# sourced (set -a; . .env.production.local), which breaks the shell.
LEAD_FROM_EMAIL="Verant <brief@verantintel.com>"

# Optional second sink: signups are also POSTed here as JSON.
LEAD_WEBHOOK_URL=
